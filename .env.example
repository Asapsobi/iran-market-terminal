# Iran Market Terminal — copy to ".env" next to docker-compose.yml:
#   cp .env.example .env
# docker compose reads it automatically. Never commit the real .env.

# Host port for the web UI / API
PORT=4000

# ---- PostgreSQL (required) ---------------------------------------------------
# Used by both the `db` service and the app. After `git pull`, `docker compose up`
# creates a fresh database and runs migrations automatically.
POSTGRES_USER=terminal
POSTGRES_PASSWORD=terminal
POSTGRES_DB=terminal
POSTGRES_PORT=5433

# Optional full URL (overrides discrete POSTGRES_* when set on the host for
# non-docker runs). Inside compose the app builds DATABASE_URL automatically.
# DATABASE_URL=postgresql://terminal:terminal@127.0.0.1:5432/terminal

# ---- Authentication ----------------------------------------------------------
AUTH_USERNAME=admin

# Generate after first build:
#   docker compose run --rm terminal python main.py hash-password "your-strong-password"
#   docker compose run --rm terminal python main.py generate-secret
AUTH_PASSWORD_HASH=
AUTH_TOKEN_SECRET=

# Dev-only plaintext (leave empty in production)
# AUTH_PASSWORD=

# ---- Optional ----------------------------------------------------------------
# ADMIN_TOKEN=
# DEMO_MODE=1

# ---- Downtime alerts (Telegram) ----------------------------------------------
# Sends a Telegram message when the collector stops getting fresh market data
# (UI up but all venues offline/stale), and again when it recovers.
# Get a token from @BotFather; get your chat id from @userinfobot (or the
# getUpdates API). Both must be set to enable alerts.
# TELEGRAM_BOT_TOKEN=123456789:AA...your-bot-token...
# TELEGRAM_CHAT_ID=123456789
# DOWNTIME_ALERT_SEC=300        # alert after data is stale this many seconds
# DOWNTIME_REMINDER_SEC=0       # re-send every N seconds while still down (0 = once)
# Telegram is filtered in Iran — set a proxy if the server can't reach it directly:
# TELEGRAM_PROXY=socks5://127.0.0.1:1080
# Outbound HTTP(S) proxy for filtered market sites (compose injects these):
# HTTP_PROXY=http://mtproxier.ir:6969
# HTTPS_PROXY=http://mtproxier.ir:6969
# NO_PROXY=db,localhost,127.0.0.1
